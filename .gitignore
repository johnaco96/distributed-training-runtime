# Rust
/target
debug
**/*.rs.bk
*.pdb
**/mutants.out*/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# The optional Rust accelerator, built by scripts/build_native.py. Never
# committed: it is a per-platform binary.
python/dtruntime/_native.so

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Runtime output directories. Anchored to the repo root so they never shadow
# a source package of the same name (python/dtruntime/data/ is a package).
/data/
/checkpoints/
/runs/
/logs/
*.log

# Scratch output from the demos, examples, and benchmarks.
.dtruntime-demo/
.dtruntime-results/
.dtruntime-certs/
.dtruntime-pytorch-smoke/
.dtruntime-pytorch-bench/

# Profiling / benchmark artifacts
perf.data
perf.data.*
.flamegraph-tmp/
tmp/

# Secrets / credentials — never commit these.
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
aws_credentials
